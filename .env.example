# Casio VN Store environment

NEXT_PUBLIC_APP_NAME=Casio VN Store
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JWT cookies for auth API routes. Change this in production/Vercel.
AUTH_SECRET=change-me-in-production

# Optional AI integration. If empty, API routes use local fallback logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
